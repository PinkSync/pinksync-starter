async function fetchConfig() {
  const response = await fetch("https://api.pinksync.com/api/config", {
    method: "GET",
    headers: { Authorization: "Bearer YOUR_JWT_TOKEN" },
  });
  const data = await response.json();
  console.log("Fetched Config:", data);
}

